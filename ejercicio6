def transformar_y_contar(texto, opcion):
    if opcion == 1:
        resultado = texto.upper()
    elif opcion == 2:
        resultado = texto.lower()
    elif opcion == 3:
        resultado = texto[::-1]
    else:
        return "Opción inválida"

    cantidad = len(resultado)
    return f"Resultado: {resultado} | Cantidad de caracteres: {cantidad}"


texto_usuario = input("Introduce un texto: ")
opcion_usuario = int(input("Introduce la opción (1, 2 o 3): "))

print(transformar_y_contar(texto_usuario, opcion_usuario))
