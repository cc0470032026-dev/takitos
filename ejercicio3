def transformar_texto(texto, opcion):
    if opcion == 1:
        return texto.upper()  # Mayúsculas
    elif opcion == 2:
        return texto.lower()  # Minúsculas
    elif opcion == 3:
        return texto[::-1]  # Al revés
    else:
        return "Opción no válida"


usuario_texto = input("Escribe algo: ")
print("Opciones: 1. Mayúsculas, 2. Minúsculas, 3. Invertir")
usuario_opcion = int(input("Elige algun numero: "))


resultado = transformar_texto(usuario_texto, usuario_opcion)
print(f"Resultado: {resultado}")
