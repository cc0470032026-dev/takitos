def transformar(texto, opcion):
    if opcion == 1:
        return texto.upper()
    elif opcion == 2:
        return texto.lower()
    elif opcion == 3:
        return texto[::-1]
    else:
        return "Opción inválida"


mi_texto = "salsa salsa, que rica salsa"

while True:
    print(f"\n--- TRABAJANDO CON: '{mi_texto}' ---")
    print("1. Convertir a MAYÚSCULAS")
    print("2. Convertir a minúsculas")
    print("3. Invertir el orden (Espejo)")
    print("4. Salir")

    opcion = int(input("\nElige una opción (1-4): "))

    if opcion == 4:
        print("¡Hasta luego!")
        break

    resultado = transformar(mi_texto, opcion)
    print(f"--- RESULTADO: {resultado} ---")
