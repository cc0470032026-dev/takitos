def procesar_texto(texto, numero):
    if numero == 1:
        print(texto.upper())
    elif numero == 2:
        print(texto.lower())
    elif numero == 3:
        print(texto.capitalize())


la_salsa = "papitas con salsa que ricas"

procesar_texto(la_salsa, 1)
procesar_texto(la_salsa, 2)
procesar_texto(la_salsa, 3)
